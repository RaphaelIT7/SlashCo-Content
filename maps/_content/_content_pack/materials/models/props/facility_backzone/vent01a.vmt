"VertexLitGeneric"
{
	$basetexture "models/props/facility_backzone/vent01a"
	"$bumpmap" "models/props/facility_backzone/vent01a_normal"

	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost"	"3"
	"$phongfresnelranges" "[.4 .9 1]"

	"$envmap" "env_cubemap"
	"$envmapsaturation" ".3"
	"$envmaptint" "[.4 .4 .4]"
	"$normalmapalphaenvmapmask" 1
}