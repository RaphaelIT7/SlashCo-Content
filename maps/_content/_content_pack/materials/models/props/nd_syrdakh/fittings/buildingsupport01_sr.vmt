"VertexlitGeneric"
{
	"$basetexture" "models/props/nd_syrdakh/fittings/buildingsupport01_sr"
    "$bumpmap" "models/props/nd_syrdakh/fittings/buildingsupport01_sr_normal"
	"$model" 1

	$envmap env_cubemap
	$normalmapalphaenvmapmask 1
	$envmaptint "[1 1 1]"
	$envmapcontrast ".9"
	$envmapsaturation ".4"

	$phong 1
	$phongexponent 0.2
	$phongboost 0.2

	vertexlitgeneric_HDR_dx9
	{
	    $envmaptint "[1 1 1]"
	    $envmapcontrast ".7"
	    $envmapsaturation ".4"
	}
}