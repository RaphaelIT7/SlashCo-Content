VertexLitGeneric
{
	$basetexture "models/props/nd_vyksa/industrial/railwaybuffer01_vk_diffuse.vtf"
	$bumpmap "models/props/nd_vyksa/industrial/railwaybuffer01_vk_normal.vtf"
	"$model" 1
	
	$envmap env_cubemap
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.5 0.5 0.5]"
	$envmapcontrast ".9"
	$envmapsaturation ".4"
}