VertexLitGeneric
{
	$basetexture "models/props/nd_vyksa/structures/oiltank02_vk_diffuse.vtf"
	$bumpmap "models/props/nd_vyksa/structures/oiltank02_vk_normal.vtf"

	$envmap env_cubemap
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.5 0.5 0.5]"
	$envmapcontrast ".9"
	$envmapsaturation ".4"

	$nocull 1
	$phong 1
	$phongexponent 0.2
	$phongboost 0.2

}