"LightMappedGeneric"
{
	"$basetexture" "Goldeneye/Casino/waterfall"
	"$bumpmap" "Goldeneye/Casino/waterfall_normal"
	"$envmap" "env_cubemap"
	"$envmaptint" "[.3 .3 .3]"
	"$translucent" "1"
	"proxies"
	{
		"TextureScroll"
		{
		"Texturescrollvar" "$Basetexturetransform"
		"Texturescrollrate" ".5"
		"texturescrollangle" "270"
		}
		TextureScroll
		{
			texturescrollvar $bumpTransform
			texturescrollrate .5
			texturescrollangle 270
		}
	}
}

